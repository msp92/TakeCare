---
import Layout from "@/layouts/Layout.astro";
import ReportDisplay from "@/components/dashboard/ReportDisplay";
import UploadHistory from "@/components/dashboard/UploadHistory";
import { createClient } from "@/lib/supabase";
import type { Upload } from "@/types";

const { user } = Astro.locals;
const status = Astro.url.searchParams.get("status");

const supabase = createClient(Astro.request.headers, Astro.cookies);
let reportContent: string | null = null;
let uploads: Upload[] = [];

if (supabase && user) {
  const { data: report } = await supabase
    .from("reports")
    .select("content")
    .eq("user_id", user.id)
    .maybeSingle<{ content: string }>();
  reportContent = report?.content ?? null;

  const { data: uploadRows } = await supabase
    .from("uploads")
    .select("*")
    .eq("user_id", user.id)
    .order("created_at", { ascending: false })
    .limit(10)
    .overrideTypes<Upload[], { merge: false }>();

  uploads = uploadRows ?? [];
}
---

<Layout title="Dashboard">
  <div class="bg-cosmic min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-3xl space-y-8">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold text-white">Dashboard</h1>
          <p class="text-sm text-blue-100/70">{user?.email}</p>
        </div>
        <div class="flex gap-3">
          <a
            href="/upload"
            class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white hover:bg-purple-500"
          >
            Upload PDF
          </a>
          <form method="POST" action="/api/auth/signout">
            <button
              type="submit"
              class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm text-white hover:bg-white/20"
            >
              Sign out
            </button>
          </form>
        </div>
      </div>

      {
        status === "success" && (
          <p class="rounded-lg border border-green-400/30 bg-green-950/30 p-3 text-sm text-green-200">
            Upload processed successfully.
          </p>
        )
      }

      <section class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
        <h2 class="mb-4 text-lg font-semibold text-white">Longitudinal report</h2>
        <ReportDisplay content={reportContent} />
      </section>

      <section class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
        <h2 class="mb-4 text-lg font-semibold text-white">Recent uploads</h2>
        <UploadHistory uploads={uploads} client:load />
      </section>
    </div>
  </div>
</Layout>
